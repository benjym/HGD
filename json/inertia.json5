{
    // resolution
    nx : 20, // width
    ny : 100, // height
    nm : 20,  // number of simultaneous simulations

    // geometry
    H : 10, // (m)
    P_stab : 0.1,

    // material properties
    repose_angle : 30, // (degrees)
    gsd_mode : 'mono',
    s_m : 0.001, // minimum particle size (m)
    // s_M : 0.01, // maximum particle size (m)
    nu_cs : 0.5,
    alpha : 1.0,

    // inertia: [false, 'time_averaging', 'derived'],
    inertia : true,
    motion_model : "d2q4_cpp",
    stream_model : "lbm_zero_eq",
    space_criterion : ["nu_cs", "pore_size"], // criterion used in both move_particles_core and stream_core_lbm_zero_eq
    tau : [0.1, 0.5, 1.0, 2.0], // relaxation time for inertia, in seconds. If tau <= 0, no relaxation is applied.
    
    // initial condition:
    nu_fill : 0.5,
    fill_ratio : 0.2,
    IC_mode : "top",

    plot_colorbar: true,
    plot : ['nu', 'U_mag'],
    videos : ['nu', 'u','v', 'U_mag'],
    
    // saving
    saves : 20,
    t_f : 5,  // s
}
