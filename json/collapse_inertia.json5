{
    // resolution
    nx : 50, // width
    ny : 50, // height
    nm : 20,  // number of simultaneous simulations

    // geometry
    H : [0.1,1,10], // (m)
    P_stab : 0.01,

    // material properties
    repose_angle : 30, // (degrees)
    gsd_mode : 'mono',
    s_m : 0.001, // minimum particle size (m)
    // s_M : 0.01, // maximum particle size (m)
    nu_cs : 0.5,
    
    // initial condition:
    nu_fill : 0.5,
    IC_mode : "left_column",

    inertia : true,
    motion_model : "d2q4_cpp",
    stream_model : "lbm_zero_eq",
    space_criterion : "pore_size", // criterion used in both move_particles_core and stream_core_lbm_zero_eq
    tau : 0.5, // relaxation time for inertia, in seconds. If tau <= 0, no relaxation is applied.
    
    plot : ['nu', 'U_mag', 'chi'],
    videos : ['nu', 'u','v', 'U_mag', 'chi'],
    plot_colorbar : true,

    // saving
    saves : 20,
    t_f : 10,  // s
}
