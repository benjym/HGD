{
    // resolution
    nx : 10, // width
    ny : 20, // height
    nm : 100,  // number of simultaneous simulations

    // geometry
    H : 0.1, // (m)
    // P_stab : 0.01,

    // material properties
    repose_angle : 30, // (degrees)
    gsd_mode : 'normal',
    // s_m : 0.001, // minimum particle size (m)
    // s_M : [0.0012,0.002,0.005], // maximum particle size (m)
    s_mean : 1e-3, // mean particle size (m)
    s_std : [1e-6,1e-5,1e-4,2e-4,3e-4,4e-4,5e-4,6e-4,7e-4], // standard deviation of particle size (m)
    s_m : 5e-4, // minimum particle size (m)
    s_M : 2e-3, // maximum particle size (m)
    beta : [3,6,9],
    
    boundaries : ["diffuse_voids"],
    applied_swap_rate : [0,0.1],
    
    // initial condition:
    nu_fill : 0.3,
    IC_mode : "full",
    // IC_mode : "small_over_large",

    // inertia: [true, false],
    inertia: false,
    
    plot : ['nu','s'],
    videos : ['nu','s'],
    save : ['nu','s'],

    // saving
    saves : 10,
    t_f : 2,  // s
}
